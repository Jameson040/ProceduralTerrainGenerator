{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:world": "esbuild tests/world.test.ts --bundle --platform=node --format=esm --outfile=.tmp/world.test.mjs && node .tmp/world.test.mjs",
    "test:materials": "esbuild tests/materials.test.ts --bundle --platform=node --format=esm --outfile=.tmp/materials.test.mjs && node .tmp/materials.test.mjs",
    "test": "npm run test:world && npm run test:materials",
    "test:browser": "playwright test",
    "shots": "node tests/browser/shots.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.34.0",
    "clsx": "2.1.1",
    "fflate": "^0.8.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "5.1.1",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "4.1.17",
    "three": "^0.187.0",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
